{
  "name": "hesap_defteri",
  "private": true,
  "version": "0.2.5",
  "description": "Küçük işletmeler için local-first hesap ve defter yönetimi.",
  "author": "Hesap Defteri",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "desktop:build": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "tr.hesapdefteri.app",
    "productName": "Hesap Defteri",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.svg",
      "artifactName": "Hesap-Defteri-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Hesap-Defteri-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "yonetimkurulu",
      "repo": "hesap_defteri",
      "releaseType": "release"
    }
  }
}
